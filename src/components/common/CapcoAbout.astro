---
/**
 * CapcoAbout — "About CAP Design Group" section.
 * Content-only (no background/wrapper): eyebrow label + heading with ember red accent +
 * body copy. Inherits the page layout's container + theme.
 */
interface Props {
  /** Heading level for the main title (h1 on a dedicated /about page, h2 inside a longer page). */
  as?: "h1" | "h2";
}

const { as = "h1" } = Astro.props;
const Heading = as;
---

<div class="max-w-3xl">
  <p
    class="mb-6 flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.2em] text-primary-600 dark:text-primary-500"
  >
    <span class="inline-block h-px w-10 bg-primary-600 dark:bg-primary-500"></span>
    About CAP Design Group
  </p>

  <Heading class="mb-8 text-4xl font-bold leading-[1.1] text-gray-900 dark:text-white md:text-5xl">
    A 30-year P.E. at your{" "}
    <em class="not-italic text-primary-600 dark:text-primary-500">plans table.</em>
  </Heading>

  <div class="space-y-6 text-lg leading-relaxed text-gray-600 dark:text-gray-300">
    <p>
      Jason Kahan, PE is a licensed fire protection engineer with over 30 years of principal-level
      experience. When you submit plans to CAP Design Group, Jason reviews them personally — no
      junior engineers, no associates, no handoffs.
    </p>
    <p>
      We specialize in PE-stamped fire protection submittals, hydraulic calculations, shop drawing
      review, and AHJ coordination across Massachusetts and greater New England. Submit your plans
      and get a stamped set back in 5–10 days — with direct accountability at every step.
    </p>
  </div>
</div>
